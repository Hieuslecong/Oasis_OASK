{
  "schema": "oasis-rc-v2.1-protocol-v5",
  "method_version": "OASIS-RC-v2.1",
  "implementation_version": "2.1.0-dev3",
  "checkpoint_schema": 5,
  "method_spec": "METHOD_SPEC_V2_1.md",
  "metric_spec": "METRIC_SPEC_V2_1.md",
  "status": "development-not-confirmatory",
  "primary_backbone": "mobilenetv3",
  "secondary_backbones": ["dsunet", "fastscnn", "multiscale"],
  "image_size": 256,
  "student_width": 16,
  "data_protocols": {
    "N0": "no-external-normal; certified native-empty rows may remain true-negative",
    "N25": "25-percent external-normal batch-composition protocol with lineage-disjoint normal_train/normal_val/normal_test",
    "normal_policy_contract": "train_and_aux_val is a strict superset of train; N0 accepts none only",
    "n0_n25_causal_claim": false,
    "matched_crack_exposure_control_required_for_normal_causal_claim": true
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.0002,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "grad_clip_norm": 5.0
  },
  "training_budget": {
    "student_epochs_development_default": 100,
    "critic_epochs_development_default": 10,
    "shared_fixed_student_budget_across_arms": true,
    "checkpoint_selection": "max-validation-micro-dice"
  },
  "critic": {
    "width": 8,
    "representation_loss": "0.5*(clean+corrupt)+rgb-shuffle-pair-only+optional-normal-donor",
    "energy_head_contract": "dedicated-scalar-lower-is-better-v1",
    "rgb_mask_weight": 1.0,
    "normal_critic_weight": 1.0,
    "energy_endpoint": {
      "weight": 1.0,
      "anchor_weight": 0.25,
      "margin": 0.05
    },
    "continuous_path": {
      "enabled": true,
      "levels": [0.0, 0.25, 0.5, 0.75, 1.0],
      "weight": 1.0,
      "margin_per_unit_t": 0.02
    },
    "qualification": {
      "classification_gate_required": true,
      "energy_gate_required": true,
      "n25_normal_texture_energy_gate_required": true,
      "n25_normal_donor_energy_gate_required": true,
      "n25_normal_donor_source": "deterministic reservoir sample of crack-positive val masks; max 64; never normal_train/test",
      "current_weights_requalification_required_for_every_critic_consumer": true,
      "stored_qualification_is_provenance_not_sole_authorization": true,
      "normal_fraction_positive_requires_normal_val": true,
      "global_energy_median_must_be_computed_over_all_validation_samples": true,
      "development_thresholds": {
        "positive_energy_gap_fraction_min": 0.70,
        "continuous_path_order_fraction_min": 0.65,
        "mean_energy_gap_gt": 0.0,
        "median_energy_gap_gt": 0.0,
        "energy_samples_min": 16,
        "energy_finite": true
      },
      "toy_release_thresholds": {
        "positive_energy_gap_fraction_min": 0.90,
        "continuous_path_order_fraction_min": 0.80,
        "mean_energy_gap_gt": 0.0,
        "median_energy_gap_gt": 0.0
      },
      "confirmatory_thresholds_must_be_frozen_after_dev": true,
      "s0_soft_prediction_gradient_diagnostic_required": true
    }
  },
  "student_rc": {
    "anchor": "SmoothL1(E_pred,E_gt)",
    "reject": "ReLU(E_pred-E_corrupted+margin)",
    "margin": 0.10,
    "corrupted_rank_weight": 1.0,
    "fp_weight": 1.0,
    "lambda_oasis_development_default": 0.001,
    "lambda_must_be_calibrated_on_development_seed_before_confirmatory": true,
    "raw_and_lambda_weighted_gradient_ratio_must_be_logged": true,
    "warmup_epochs": 4,
    "ramp_epochs": 3
  },
  "aosk": {
    "variant": "structure-tensor-steered-v2",
    "development_lambda_default": 0.01,
    "orientation": "2x2 structure tensor with Jxx/Jyy/Jxy, tangent eigen-orientation, bilinear +/-tangent sampling",
    "low_coherence_policy": "smooth isotropic fallback",
    "claim": "arbitrary-angle image-guided local consistency; not a topology loss"
  },
  "strong_baselines": {
    "B0": "BCE+Dice",
    "B1": "BCE+Dice+clDice",
    "B2": "BCE+Dice+frozen-pretrained-pair-critic (ablation; not conventional jointly-trained adversarial)",
    "S1": "BCE+Dice+RC-v2.1",
    "S2": "BCE+Dice+AOSK-structure-tensor-v2",
    "S3": "BCE+Dice+RC-v2.1+AOSK-structure-tensor-v2"
  },
  "selection": {
    "checkpoint": "max validation micro Dice on crack validation population",
    "threshold": "max validation micro Dice on crack validation population",
    "topology_and_fp_are_secondary_outcomes_not_selection_targets": true
  },
  "statistics": {
    "development_seed": 1337,
    "confirmatory_primary_seeds": [2027, 31415, 42421, 51511, 62617],
    "confirmatory_seed_set_must_be_exact": true,
    "secondary_backbone_min_seeds": 3,
    "paired_by_seed_and_initialization": true,
    "sampling_unit": "training_seed",
    "seed_level_delta_required": true,
    "seed_bootstrap_ci": true,
    "exact_sign_flip_p_is_secondary": true,
    "holm_correction_within_metric_family": true,
    "report_effect_size_cohen_dz": true,
    "report_mean_std_median_direction_consistency": true,
    "all_preregistered_metrics_complete_and_finite_for_every_seed": true,
    "development_seed_excluded_from_confirmatory_if_any_tuning_occurs": true
  },
  "evaluation": {
    "metric_spec": "METRIC_SPEC_V2_1.md",
    "crack_population_pixel": ["precision", "recall", "dice", "iou"],
    "crack_population_per_image": ["dice", "iou"],
    "structure_on_crack_rows": ["cldice", "skeleton_precision", "skeleton_recall", "component_excess"],
    "false_positive_on_normal_rows": ["normal_fp_pixels", "normal_fp_components", "normal_any_fp_rate"],
    "never_average_crack_overlap_metrics_over_true_negative_rows": true,
    "deployment": ["parameters", "macs_or_flops", "checkpoint_bytes", "batch1_latency", "fps", "peak_memory"],
    "save_per_image_predictions_before_final_close": true
  },
  "final_test": {
    "policy": "single-open immutable six-arm five-seed bundle",
    "canonical_splits": ["test", "normal_test"],
    "development_evaluators_must_refuse_both_canonical_splits": true,
    "content_addressed_bundle_id": true,
    "stable_external_ledger_root_required": true,
    "canonical_test_must_remain_closed_during_development": true,
    "required_arms": ["B0", "B1", "B2", "S1", "S2", "S3"],
    "required_confirmatory_seeds": [2027, 31415, 42421, 51511, 62617],
    "required_checkpoint_count": 30,
    "checkpoint_arm_mode_binding_required": true,
    "shared_student_initialization_per_seed_required": true,
    "shared_training_view_and_gate0_per_seed_required": true,
    "checkpoint_runtime_git_sha_must_equal_frozen_git_commit_sha": true,
    "metric_spec_path_and_sha256_required": true,
    "bind": [
      "dataset_content_sha256",
      "manifest_sha256",
      "full_gate0_certificate_sha256",
      "method_spec_sha256",
      "protocol_sha256",
      "evaluator_sha256",
      "metric_spec_sha256",
      "checkpoint_sha256s",
      "thresholds",
      "git_commit_sha"
    ]
  },
  "inference_contract": "RGB -> crack logits only"
}
