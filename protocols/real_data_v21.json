{
  "schema": "oasis-rc-v2.1-protocol-v1",
  "method_version": "OASIS-RC-v2.1",
  "implementation_version": "2.1.0-dev",
  "method_spec": "METHOD_SPEC_V2_1.md",
  "status": "development-not-confirmatory",
  "primary_backbone": "mobilenetv3",
  "secondary_backbones": ["dsunet", "fastscnn", "multiscale"],
  "image_size": 256,
  "student_width": 16,
  "data_protocols": {
    "N0": "no-external-normal; certified native-empty rows may remain true-negative",
    "N25": "25-percent external-normal update-budget protocol",
    "n0_n25_causal_claim": false,
    "matched_crack_exposure_control_required_for_normal_causal_claim": true
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.0002,
    "weight_decay": 0.01,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "grad_clip_norm": 5.0
  },
  "critic": {
    "width": 8,
    "classification_loss": "0.5*(clean+corrupt)+rgb-shuffle-pair-only+optional-normal-donor",
    "rgb_mask_weight": 1.0,
    "normal_critic_weight": 1.0,
    "continuous_path": {
      "enabled": true,
      "levels": [0.0, 0.25, 0.5, 0.75, 1.0],
      "weight": 0.25,
      "margin_per_unit_t": 0.02
    },
    "qualification": {
      "classification_gate_required": true,
      "energy_gate_required": true,
      "development_thresholds": {
        "positive_energy_gap_fraction_min": 0.70,
        "continuous_path_order_fraction_min": 0.65,
        "mean_energy_gap_gt": 0.0,
        "median_energy_gap_gt": 0.0,
        "energy_samples_min": 16,
        "energy_finite": true
      },
      "confirmatory_thresholds_must_be_frozen_after_dev": true,
      "s0_soft_prediction_gradient_diagnostic_required": true
    }
  },
  "student_rc": {
    "anchor": "SmoothL1(E_pred,E_gt)",
    "reject": "ReLU(E_pred-E_corrupted+margin)",
    "margin": 0.10,
    "pair_weight": 0.25,
    "corrupted_rank_weight": 1.0,
    "fp_weight": 1.0,
    "lambda_oasis": 0.001,
    "warmup_epochs": 4,
    "ramp_epochs": 3
  },
  "aosk": {
    "variant": "oriented-consistency-v1-isotropic-flat",
    "lambda": 0.01,
    "claim": "orientation-aware local consistency; not a topology loss"
  },
  "strong_baselines": {
    "B0": "BCE+Dice",
    "B1": "BCE+Dice+clDice",
    "B2": "BCE+Dice+conventional-pair-adversarial",
    "S1": "BCE+Dice+RC-v2.1",
    "S2": "BCE+Dice+AOSK",
    "S3": "BCE+Dice+RC-v2.1+AOSK"
  },
  "selection": {
    "checkpoint": "max validation micro Dice",
    "threshold": "max validation micro Dice; normal-FP tie break only",
    "topology_and_fp_are_secondary_outcomes_not_selection_targets": true
  },
  "statistics": {
    "development_seed": 1337,
    "confirmatory_primary_seeds": [2027, 31415, 42421, 51511, 62617],
    "secondary_backbone_min_seeds": 3,
    "paired_by_seed_and_initialization": true,
    "per_image_paired_bootstrap_ci": true,
    "report_mean_std_median_direction_consistency": true,
    "development_seed_excluded_from_confirmatory_if_any_tuning_occurs": true
  },
  "evaluation": {
    "pixel": ["precision", "recall", "dice", "iou"],
    "per_image": ["dice", "iou"],
    "structure": ["cldice", "skeleton_precision", "skeleton_recall"],
    "false_positive": ["normal_fp_pixels", "normal_fp_components", "normal_any_fp_rate"],
    "deployment": ["parameters", "macs_or_flops", "checkpoint_bytes", "batch1_latency", "fps", "peak_memory"],
    "save_per_image_predictions_before_final_close": true
  },
  "final_test": {
    "policy": "single-open immutable multi-checkpoint bundle",
    "canonical_test_must_remain_closed_during_development": true,
    "bind": [
      "dataset_content_sha256",
      "manifest_sha256",
      "full_gate0_certificate_sha256",
      "method_spec_sha256",
      "protocol_sha256",
      "evaluator_sha256",
      "metric_spec_sha256",
      "checkpoint_sha256s",
      "thresholds",
      "git_commit_sha"
    ]
  },
  "inference_contract": "RGB -> crack logits only"
}
